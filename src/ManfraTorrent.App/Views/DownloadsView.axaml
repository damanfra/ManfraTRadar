<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ManfraTorrent.App.Views.DownloadsView">

  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="28,24,28,0">

    <!-- Título + totais -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,16">
      <TextBlock Classes="h1" Text="Downloads" VerticalAlignment="Center" />
      <Border Grid.Column="1" Classes="card" Padding="14,8" Margin="0,0,10,0">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Baixando" Classes="muted" VerticalAlignment="Center" />
          <TextBlock Text="{Binding TotalDownText, StringFormat='↓ {0}'}" Classes="mono" FontSize="16"
                     Foreground="{StaticResource AccentBrush}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="card" Padding="14,8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Enviando" Classes="muted" VerticalAlignment="Center" />
          <TextBlock Text="{Binding TotalUpText, StringFormat='↑ {0}'}" Classes="mono" FontSize="16"
                     Foreground="{StaticResource LeechBrush}" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Adicionar -->
    <Border Grid.Row="1" Classes="card" Padding="14" Margin="0,0,0,14">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
          <TextBox Text="{Binding AddInput}"
                   Watermark="Cole um link magnet ou a URL de um .torrent e tecle Enter">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <CheckBox Grid.Column="1" Margin="12,0,0,0" IsChecked="{Binding AddSequential}"
                    Content="Em ordem" ToolTip.Tip="Baixar as partes em ordem para assistir enquanto baixa" />
          <Button Grid.Column="2" Classes="primary" Margin="10,0,0,0" Content="Adicionar"
                  Command="{Binding AddCommand}" IsEnabled="{Binding !IsAdding}" />
          <Button Grid.Column="3" Classes="ghost" Margin="8,0,0,0" Content="Abrir .torrent…"
                  Command="{Binding OpenTorrentFileCommand}" />
        </Grid>
        <TextBlock Text="{Binding StatusText}" Classes="muted" IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- Filtros + pasta -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
      <ListBox Classes="chips" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}"
               SelectionMode="Single,AlwaysSelected">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
      </ListBox>
      <Button Grid.Column="2" Classes="link" Command="{Binding OpenDownloadFolderCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Classes="icon" Width="16" Height="16" Stroke="{StaticResource AccentBrush}"
                Data="M3,7 A2,2 0 0 1 5,5 L9,5 L11,7 L19,7 A2,2 0 0 1 21,9 L21,17 A2,2 0 0 1 19,19 L5,19 A2,2 0 0 1 3,17 Z" />
          <TextBlock Text="{Binding FolderText}" VerticalAlignment="Center" MaxWidth="420"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- Lista -->
    <Border Grid.Row="3" BorderBrush="{StaticResource RowLineBrush}" BorderThickness="0,1,0,0">
      <Panel>
        <ListBox Classes="rows" ItemsSource="{Binding Visible}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">

                <StackPanel Grid.Row="0" Spacing="3">
                  <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding StatusText}" Classes="muted" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <ProgressBar Grid.Row="1" Classes="bar" Classes.done="{Binding IsComplete}"
                             Classes.paused="{Binding IsPaused}"
                             Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Margin="0,10,0,6" />

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding LeftText}" Classes="mono muted" />
                  <TextBlock Grid.Column="1" Text="{Binding RightText}" Classes="mono" FontSize="12"
                             Foreground="{StaticResource AccentBrush}" />
                </Grid>

                <StackPanel Grid.Column="1" Grid.RowSpan="3" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center" Margin="18,0,0,0">
                  <Button Classes="round neutral" Command="{Binding TogglePauseCommand}"
                          IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Pausar / retomar">
                    <Panel>
                      <Path Classes="icon" Width="14" Height="14" Stroke="#C9CED6"
                            IsVisible="{Binding IsRunning}" Data="M9,5 L9,19 M15,5 L15,19" />
                      <Path Classes="icon" Width="14" Height="14" Stroke="#C9CED6"
                            IsVisible="{Binding !IsRunning}" Data="M8,5 L19,12 L8,19 Z" />
                    </Panel>
                  </Button>
                  <Button Classes="round neutral" Command="{Binding OpenFolderCommand}" ToolTip.Tip="Abrir pasta">
                    <Path Classes="icon" Width="16" Height="16" Stroke="#C9CED6"
                          Data="M3,7 A2,2 0 0 1 5,5 L9,5 L11,7 L19,7 A2,2 0 0 1 21,9 L21,17 A2,2 0 0 1 19,19 L5,19 A2,2 0 0 1 3,17 Z" />
                  </Button>
                  <Button Classes="round neutral" ToolTip.Tip="Mais opções">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                      <Ellipse Width="4" Height="4" Fill="#C9CED6" />
                      <Ellipse Width="4" Height="4" Fill="#C9CED6" />
                      <Ellipse Width="4" Height="4" Fill="#C9CED6" />
                    </StackPanel>
                    <Button.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="Copiar link magnet" Command="{Binding CopyMagnetCommand}" />
                        <MenuItem Header="Abrir pasta" Command="{Binding OpenFolderCommand}" />
                        <Separator />
                        <MenuItem Header="Remover da lista (manter arquivos)" Command="{Binding RemoveCommand}" />
                        <MenuItem Header="Remover e apagar arquivos" Command="{Binding RemoveWithFilesCommand}"
                                  Foreground="{StaticResource DangerBrush}" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel IsVisible="{Binding IsEmpty}" Spacing="6"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0">
          <TextBlock Text="Nenhum download aqui." FontSize="15" HorizontalAlignment="Center" />
          <TextBlock Text="Escolha algo em Descobrir ou cole um link magnet acima." Classes="muted"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Panel>
    </Border>
  </Grid>
</UserControl>
